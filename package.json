{
  "name": "@owdproject/nuxt-theme-win11",
  "version": "4.0.0-alpha.3",
  "description": "Windows 11 desktop theme for OWD clients",
  "homepage": "https://github.com/dxlliv/owd-nuxt-theme-win11#readme",
  "license": "MIT",
  "author": {
    "name": "Diego Villa",
    "url": "https://github.com/dxlliv"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "development": "./src/module.ts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "nx": {
    "name": "theme-win11"
  },
  "scripts": {
    "prepublishOnly": "node -e 'if (process.env.npm_package_version?.includes(\"verdaccio\") && !process.env.ALLOW_VERDACCIO) { console.error(\"FATAL: Snapshot versions (*-verdaccio.*) cannot be published to public npm!\"); process.exit(1); }'",
    "prepack": "nuxt-module-build build",
    "dev": "pnpm run dev:prepare && cd playground && pnpm exec nuxt dev",
    "dev:build": "nuxt build playground",
    "dev:generate": "NUXT_APP_BASE_URL=${NUXT_APP_BASE_URL:-/theme-win11/} nuxt generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && cd playground && pnpm exec nuxt prepare",
    "validate": "desktop validate ."
  },
  "dependencies": {
    "@nuxt/kit": "^4.6.2",
    "@owdproject/nuxt-kit-primevue": "^4.0.0-alpha.3",
    "defu": "^6.1.4",
    "vuedraggable": "^4.1.0",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.6.2",
    "@owdproject/core": "^4.0.0-alpha.3",
    "@owdproject/nuxt-module-fs": "^4.0.0-alpha.3",
    "@owdproject/nuxt-kit-primevue": "^4.0.0-alpha.3",
    "@owdproject/nuxt-kit-tailwind": "^4.0.0-alpha.3",
    "nuxt": "^4.6.2",
    "typescript": "~6.0.3"
  },
  "optionalDependencies": {
    "@owdproject/nuxt-app-classic-audioplayer": "^4.0.0-alpha.3",
    "@owdproject/nuxt-module-pinia-persistence": "^4.0.0-alpha.3"
  },
  "peerDependencies": {
    "@owdproject/core": ">=4.0.0-alpha.0",
    "@owdproject/nuxt-kit-primevue": "^4.0.0-alpha.3",
    "@owdproject/nuxt-kit-tailwind": "^4.0.0-alpha.3",
    "@owdproject/nuxt-module-fs": "^4.0.0-alpha.3",
    "nuxt": "^4.6.2",
    "@owdproject/nuxt": "^4.0.0-alpha.3"
  },
  "peerDependenciesMeta": {
    "@owdproject/nuxt-module-fs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
